@model IEnumerable<MultilingualSite.Models.Club>

@{
    ViewBag.Title = @Resources.Resource.IndexHeader;
}

<h2 class="mb-4">@Resources.Resource.IndexHeader</h2>

<div class="table-responsive">
    <table class="table table-hover table-striped shadow-sm">
        <thead class="table-light">
            <tr>
                <th><label asp-for="@Model.First().Name"></label></th>
                <th><label asp-for="@Model.First().City"></label></th>
                <th><label asp-for="@Model.First().Country"></label></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.City</td>
                    <td>@item.Country</td>
                </tr>
            }
        </tbody>
    </table>
</div>